# ---------------------------------------------------------------------------
# Secretos y configuración local
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# PHP / Laravel (api/)
# ---------------------------------------------------------------------------
/api/vendor/
/api/node_modules/
/api/public/build/
/api/public/hot
/api/public/storage
/api/storage/*.key
/api/storage/framework/cache/*
/api/storage/framework/sessions/*
/api/storage/framework/testing/*
/api/storage/framework/views/*
/api/storage/logs/*
!/api/storage/framework/cache/.gitignore
!/api/storage/framework/sessions/.gitignore
!/api/storage/framework/testing/.gitignore
!/api/storage/framework/views/.gitignore
!/api/storage/logs/.gitignore
/api/bootstrap/cache/*.php
!/api/bootstrap/cache/.gitignore
/api/.phpunit.cache/
/api/.phpunit.result.cache
/api/coverage/
/api/_ide_helper.php
/api/_ide_helper_models.php
/api/.phpactor.json
/api/.php-cs-fixer.cache

# ---------------------------------------------------------------------------
# Node / Vue (web/)
# ---------------------------------------------------------------------------
node_modules/
web/dist/
web/dist-ssr/
web/.vite/
web/coverage/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Código legado (solo se versiona el código fuente, no dependencias ni builds)
# ---------------------------------------------------------------------------
legacy/backend/node_modules/
legacy/frontend/node_modules/
legacy/frontend/dist/
legacy/**/uploads/*
!legacy/**/uploads/.gitkeep

# ---------------------------------------------------------------------------
# Herramientas locales / temporales
# ---------------------------------------------------------------------------
/tools/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
